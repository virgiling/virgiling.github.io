---
import SiteLayout from "./SiteLayout.astro";
import Comments from "../components/Comments.astro";
import { url } from "../site.config";
import ReadingMeta from "../components/ReadingMeta.astro";
import ReadingSidebar from "../components/ReadingSidebar.astro";
import OnThisPage from "../components/OnThisPage.astro";
import GraphDialog from "../components/GraphDialog.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FreshnessNotice from "../components/FreshnessNotice.astro";
import { tagURL } from "../ui/shared";
import type { Note, Snapshot } from "../content/types";
import { articleImages } from "../images/article";
import { parseFriendLinks } from "../friends/markdown";
import { friendSnapshot } from "../friends/snapshot";
import { circlePosts } from "../friends/feeds";
import FriendCards from "../components/FriendCards.astro";
import FriendCircle from "../components/FriendCircle.astro";
interface Props {
  note: Note;
  snapshot: Snapshot;
}
const { note, snapshot } = Astro.props;
const friends =
  note.source === "link.md" && !note.unlisted
    ? parseFriendLinks(note.html)
    : undefined;
const feedResults = friends?.friends.length
  ? await friendSnapshot(friends.friends)
  : [];
const readingNote = friends?.friends.length
  ? {
      ...note,
      headings: [
        ...note.headings,
        { id: "page-title", text: "近况", depth: 1, trail: ["近况"] },
      ],
    }
  : note;
const articleHTML = articleImages(friends?.html ?? note.html);
const active =
  note.source === "link.md"
    ? "friends"
    : note.source === "index.md"
      ? "home"
      : note.source === "about.md"
        ? "about"
        : "articles";
const related = snapshot.listed.filter(
  (n) => note.links.includes(n.id) || n.links.includes(note.id),
);
const previews = related.map((n) => ({
  slug: n.id,
  url: n.url,
  title: n.title,
  tags: n.tags,
  summary: n.summary,
}));
---

<SiteLayout
  title={note.title}
  description={note.summary}
  path={note.route}
  active={active}
  reading
  unlisted={note.unlisted}
>
  <main class="shell article-layout" id="main">
    <article class="article" data-note-id={note.id}>
      <Breadcrumbs
        note={note}
        pages={snapshot.listed}
        directories={snapshot.directories}
      />
      {!friends?.friends.length && (
        <header class="article-header">
          <div class="eyebrow">FROM THE NOTEBOOK</div>
          <h1 id="page-title">{note.title}</h1>
          <ReadingMeta note={note} />
          {note.tags.length > 0 && (
            <div class="article-tags">
              {note.tags.map((t) =>
                note.unlisted ? (
                  <span class="tag">{t}</span>
                ) : (
                  <a class="tag" href={tagURL(t)}>
                    {t}
                  </a>
                ),
              )}
            </div>
          )}
        </header>
      )}
      <FreshnessNotice
        note={note}
        asOf={process.env.BUILD_DATE || new Date().toISOString().slice(0, 10)}
      />
      <div class="prose" set:html={articleHTML} />
      {friends?.friends.length ? (
        <>
          <FriendCards friends={friends.friends} />
          <FriendCircle
            posts={circlePosts(feedResults)}
            results={feedResults}
          />
        </>
      ) : null}
      <Comments note={note} />
      {note.kind !== "landing" && (
        <div class="article-bottom">
          <a href={url("articles")}>← 返回文章</a>
        </div>
      )}
    </article>
    <ReadingSidebar note={readingNote} pages={snapshot.listed} />
  </main>
  <button
    class="mobile-outline"
    id="open-outline"
    aria-haspopup="dialog"
    aria-controls="outline-dialog"
  >
    ☷ ON THIS PAGE
  </button>
  <dialog id="outline-dialog" class="outline-dialog" aria-label="ON THIS PAGE">
    <button class="dialog-close" id="close-outline">
      关闭
    </button>
    <OnThisPage headings={readingNote.headings} mobile />
    <a class="outline-relations" href="#graph-heading">
      关系图谱 ↓
    </a>
  </dialog>
  <GraphDialog note={note} />
  <script
    is:inline
    type="application/json"
    id="preview-data"
    set:html={JSON.stringify(previews).replace(/</g, "\\u003c")}
  />
</SiteLayout>

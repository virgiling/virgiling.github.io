---
import { PenLine, History } from "lucide";
interface Props {
  kind: "created" | "updated";
}
const { kind } = Astro.props;
const paths = kind === "created" ? PenLine : History;
---

<svg
  class="meta-icon"
  data-icon={kind}
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {paths.map(([tag, attributes]) => {
    const Shape = tag as "path" | "circle" | "polyline";
    return <Shape {...attributes} />;
  })}
</svg>

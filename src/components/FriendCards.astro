---
import type { Friend } from "../friends/markdown";
import TaggedText from "./TaggedText.astro";
interface Props {
  friends: Friend[];
  tags?: string[];
  hoverMotion?: boolean;
}
const { friends, tags = [], hoverMotion = false } = Astro.props;
---

<section class="friends-section" id="friend-links" aria-label="友链">
  <div class="friend-grid">
    {friends.map((friend) => (
      <div class="friend-card" data-card-motion={hoverMotion ? "" : undefined}>
        <a
          class="friend-main-link"
          href={friend.url}
          rel="noopener noreferrer"
          aria-label={friend.name}
        ></a>
        <span class="friend-avatar" aria-hidden="true">
          {friend.avatar ? (
            <img
              src={friend.avatar}
              alt=""
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            />
          ) : (
            [...friend.name][0] || "友"
          )}
        </span>
        <span>
          <strong>
            <TaggedText text={friend.name} tags={tags} />
          </strong>
          <span class="friend-bio">
            <TaggedText text={friend.bio} tags={tags} />
          </span>
          <span class="friend-domain">{new URL(friend.url).hostname}</span>
        </span>
      </div>
    ))}
  </div>
</section>

---
import type { Heading } from "../content/types";
import TaggedText from "./TaggedText.astro";
interface Props {
  headings: Heading[];
  mobile?: boolean;
  linkTags?: boolean;
}
const { headings, mobile = false, linkTags = true } = Astro.props;
const outline = headings.filter((heading) => heading.depth <= 3);
const rootDepth = Math.min(3, ...outline.map((heading) => heading.depth));
---

<nav class="on-this-page" aria-label={`${mobile ? "移动端 " : ""}ON THIS PAGE`}>
  <div class="rail-head">
    <h2 class="side-title">ON THIS PAGE</h2>
  </div>
  <div class="toc-scroll">
    <div class="toc-track">
      <span class="toc-marker" aria-hidden="true" hidden></span>
      <ol class="toc">
        {outline.map((heading) => (
          <li
            data-depth={heading.depth}
            class:list={{ "toc-child": heading.depth > rootDepth }}
            style={{ "--toc-indent": `${(heading.depth - rootDepth) * 20}px` }}
          >
            <span class="toc-entry" data-heading={heading.id}>
              <TaggedText
                text={heading.text}
                parts={heading.parts}
                enabled={linkTags}
                href={`#${encodeURIComponent(heading.id)}`}
              />
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</nav>

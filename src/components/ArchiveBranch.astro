---
import ArchiveStack from "./ArchiveStack.astro";
import { sortedFolders, type FolderNode } from "../ui/archive.ts";
import { folderFrameId } from "../ui/shared";
interface Props {
  node: FolderNode;
  depth: number;
}
const { node, depth } = Astro.props;
const Heading = `h${Math.min(depth, 6)}` as "h3" | "h4" | "h5" | "h6";
---

<section
  class="folder-subframe"
  id={folderFrameId(node.path)}
  data-folder-path={node.path}
>
  <Heading class="folder-branch-heading">
    <span aria-hidden="true">↳</span>
    {node.label}
  </Heading>
  <ArchiveStack node={node} depth={depth} />
  {sortedFolders(node.children.values()).map((child) => (
    <Astro.self node={child} depth={depth + 1} />
  ))}
</section>

---
import HomeActivity from "./HomeActivity.astro";
import TaggedText from "./TaggedText.astro";
import OnThisPage from "./OnThisPage.astro";
import LocalGraph from "./LocalGraph.astro";
import { relations } from "../ui/reading.ts";
import { siteConfig } from "../site.config";
import type { Note } from "../content/types";
interface Props {
  note: Note;
  pages: Note[];
  config?: typeof siteConfig;
}
const { note, pages, config = siteConfig } = Astro.props;
const { incoming, connected } = relations(note, pages);
const home = note.source === "index.md";
---

<aside class:list={["sidebar", { "home-sidebar": home }]} aria-label="阅读辅助">
  {home && <HomeActivity pages={pages} config={config.home} />}
  <LocalGraph
    note={note.unlisted ? { ...note, tags: [] } : note}
    neighbors={connected}
  />
  <section class="side-section">
    <OnThisPage headings={note.headings} linkTags={!note.unlisted} />
  </section>
  {!home && (
    <section class="side-section">
      <h2 class="side-title">
        反向链接 <small>{incoming.length}</small>
      </h2>
      {incoming.length ? (
        <ul class="backlinks">
          {incoming.map((page) => (
            <li>
              <TaggedText
                text={`↗ ${page.title}`}
                tags={page.tags}
                href={page.url}
                linkAttributes={{ "data-preview": page.slug }}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="side-empty">暂无反向链接。</p>
      )}
    </section>
  )}
</aside>

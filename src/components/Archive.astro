---
import ArchiveStack from "./ArchiveStack.astro";
import ArchivePagination from "./ArchivePagination.astro";
import type { ArchivePagination as PaginationModel } from "../ui/archive-pagination";
import ArchiveBranch from "./ArchiveBranch.astro";
import TaggedText from "./TaggedText.astro";
import { linkableTags } from "../inline-tags";
import {
  buildFolderTree,
  sortedFolders,
  type ArchiveConfig,
} from "../ui/archive.ts";
import { folderId, folderFrameId } from "../ui/shared";
import type { CatalogNote } from "../ui/types";
interface Props {
  notes: CatalogNote[];
  config?: ArchiveConfig;
  pagination?: PaginationModel;
  pageIndex?: number;
}
const { notes, config = {}, pagination, pageIndex = 0 } = Astro.props;
const slice = pagination?.pages[pageIndex];
const roots = pagination
  ? slice
    ? [slice.root]
    : []
  : buildFolderTree(notes, config.directories);
const order = config.rootOrder || [];
roots.sort(
  (a, b) =>
    (order.includes(a.path) ? order.indexOf(a.path) : order.length) -
      (order.includes(b.path) ? order.indexOf(b.path) : order.length) ||
    a.path.localeCompare(b.path, "en"),
);
const represented = new Set(
  (pagination ? pagination.pages.map((page) => page.root) : roots).flatMap(
    (root) => [...root.members, ...(root.moc ? [root.moc.slug] : [])],
  ),
);
const tags = [
  ...new Set(
    notes.filter((n) => represented.has(n.slug)).flatMap(linkableTags),
  ),
];
function hasDirectory(
  node: import("../ui/archive").FolderNode | undefined,
  path: string,
): boolean {
  return (
    !!node &&
    (node.path === path ||
      [...node.children.values()].some((child) => hasDirectory(child, path)))
  );
}
---

<main class="shell archive-page" id="main">
  <div class="page-intro">
    <h1>文章</h1>
  </div>
  {pagination && (
    <>
      <nav class="archive-directories" aria-label="按目录浏览">
        {pagination.directories
          .filter((d) => d.root)
          .map((d) => (
            <a
              class="archive-control"
              data-control-motion
              href={d.href}
              id={
                d.path === slice?.root.path ? undefined : folderFrameId(d.path)
              }
              aria-current={d.path === slice?.root.path ? "true" : undefined}
            >
              <span class="archive-directory-name">{d.label}</span>
              <span
                class="archive-directory-count"
                aria-label={`${d.count} 则笔记`}
              >
                {d.count} 则
              </span>
            </a>
          ))}
      </nav>
      {pageIndex === 0 && (
        <div class="archive-legacy-links" aria-label="子目录入口">
          {pagination.directories
            .filter((d) => !d.root && !hasDirectory(slice?.root, d.path))
            .map((d) => (
              <a class="sr-only" id={folderFrameId(d.path)} href={d.href}>
                {d.label} →
              </a>
            ))}
        </div>
      )}
      <ArchivePagination index={pageIndex} total={pagination.pages.length} />
    </>
  )}
  <div class="folder-tree">
    {roots.map((root, index) => (
      <section
        class="folder-frame"
        id={folderFrameId(root.path)}
        data-folder-root={root.path}
        aria-labelledby={`root-${folderId(root.path)}`}
      >
        <header class="folder-frame-header">
          <span class="frame-number">
            {String((slice?.rootIndex ?? index) + 1).padStart(2, "0")}
          </span>
          <h2 id={`root-${folderId(root.path)}`}>
            {root.moc ? (
              <span
                class="folder-heading-link archive-control"
                data-control-motion
              >
                <span class="folder-heading-name">
                  <TaggedText
                    text={root.label}
                    tags={tags}
                    href={root.moc.url}
                  />
                </span>{" "}
                <a
                  class="folder-link-hint"
                  href={root.moc.url}
                  data-directory-moc={slice?.part ? undefined : root.moc.source}
                  aria-label={`打开 ${root.label}`}
                >
                  <svg
                    class="folder-link-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path d="M3 8h10M8 3l5 5-5 5" />
                  </svg>
                </a>
              </span>
            ) : (
              <TaggedText text={root.label} tags={tags} />
            )}
          </h2>
        </header>
        {slice && slice.parts > 1 && (
          <p class="frame-page">
            本目录第 {slice.part + 1} / {slice.parts} 页
          </p>
        )}
        <ArchiveStack node={root} depth={2} />
        {sortedFolders(root.children.values()).map((child) => (
          <ArchiveBranch node={child} depth={3} tags={tags} />
        ))}
      </section>
    ))}
  </div>
</main>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSnapshot } from "../content/snapshot";
import Archive from "../components/Archive.astro";
import { siteConfig } from "../site.config";
const snapshot = await getSnapshot();
---

<SiteLayout title="文章" active="articles" path="articles">
  <Archive
    notes={snapshot.listed.filter((n) => n.kind !== "landing")}
    config={{ ...siteConfig.archive, directories: snapshot.directories }}
  />
</SiteLayout>

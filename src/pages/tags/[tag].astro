---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSnapshot } from "../../content/snapshot";
import TagPage from "../../components/TagPage.astro";
import { buildTags, type TagGroup } from "../../ui/tags.ts";
import { url } from "../../site.config";
export async function getStaticPaths() {
  return buildTags((await getSnapshot()).listed).map((group) => ({
    params: { tag: Buffer.from(group.tag).toString("hex") },
    props: { group },
  }));
}
interface Props {
  group: TagGroup;
}
const { group } = Astro.props;
---

<SiteLayout
  title={"#" + group.tag}
  active="articles"
  path={"tags/" + Buffer.from(group.tag).toString("hex")}
>
  <TagPage group={group} articleURL={url("articles")} />
</SiteLayout>

@article{hu5320571large,
  title = {A Large Neighborhood Search with Deep Optimization for the Weighted Total Domination Problem in Massive Graphs},
  journal = {Knowledge-Based Systems},
  pages = {116140},
  year = {2026},
  issn = {0950-7051},
  doi = {https://doi.org/10.1016/j.knosys.2026.116140},
  url = {https://www.sciencedirect.com/science/article/pii/S095070512600866X},
  author = {Shuli Hu and Wen Wen and Dian Ling and Jiaqi Li and Ziqing Liao and Ruizhi Li and Minghao Yin*},
  keywords = {Weighted total dominating set, Deep optimization, Large neighborhood search, Massive graph},
  abstract = {The weighted total domination problem (WTDP) is an important generalization of the total dominating set problem, incorporating both vertex and edge weights to optimize costs in practical applications, such as information spreading and distributed network design. In this study, we designed an efficient destroy–repair–improve large neighborhood search with deep optimization for WTDP in massive graphs, structured in three phases. First, two new reduction strategies were applied to reduce the size of the original graphs, and then we proposed a greedy heuristic to construct a promising feasible initial solution. Second, we applied a novel destroy–repair–improve large neighborhood search to refine the initial solution. To guide the search process, we proposed a new vertex selection strategy that integrates a dynamic scoring function with an enhanced three-valued two-level configuration-checking mechanism. To improve the solution, we introduced three operators, shrink, swap, and expand, to obtain promising high-quality solutions. Third, deep optimization was applied to escape local optima by introducing strategic perturbations when the large neighborhood search fails to improve the solution for a prolonged period. We evaluated our algorithm on 352 benchmark instances, including 37 massive real-world graphs and 315 synthetic instances. On the massive graphs, it yielded 29 new upper bounds and matched five best-known results. On the smaller instances, it achieved six new upper bounds and matched 309 best-known results. These results demonstrate the excellent solution quality of our approach, along with competitive efficiency observed in most cases.},
  shortName={KBS},
  selected={true},
  researchArea={Combination & Optimization Problem},
  ccfFlag={CCF-C}
}



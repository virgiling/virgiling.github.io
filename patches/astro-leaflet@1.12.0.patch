+// Copyright (c) Pascal Brand
+// MIT License
+// Client registration is separate so hosts can load Leaflet and its CSS on demand.
+import { map as Lmap, tileLayer as LtileLayer } from 'leaflet';
+import type { Map } from 'leaflet';
+import type { AstroLeafletOptionsType } from '../index';
+export { default as stylesheet } from 'leaflet/dist/leaflet.css?url';
+
+class CustomElementAstroLeaflet extends HTMLElement {
+  leafletElement: Map | undefined;
+
+  activate() {
+    this.dataset.active = '';
+    this.connectedCallback();
+  }
+
+  connectedCallback() {
+    if (this.leafletElement || !this.isConnected || ('defer' in this.dataset && !('active' in this.dataset))) return;
+    const options: AstroLeafletOptionsType = JSON.parse(this.dataset.options!);
+    const id = this.dataset.id!;
+    try {
+      const map = this.leafletElement = Lmap(id, options.mapOptions);
+      if (options.center) map.setView(options.center, options.zoom, options.setViewOptions);
+      if (options.tileLayer) LtileLayer(options.tileLayer, options.tileLayerOptions).addTo(map);
+    } catch (error) {
+      this.disconnectedCallback();
+      throw error;
+    }
+  }
+
+  disconnectedCallback() {
+    this.leafletElement?.remove();
+    this.leafletElement = undefined;
+    delete this.dataset.active;
+  }
+}
+customElements.get('astro-leaflet') || customElements.define('astro-leaflet', CustomElementAstroLeaflet);
+
+import { CustomElementLayerGroup } from './customElements/layergroup';
+customElements.get('astro-leaflet-layergroup') || customElements.define('astro-leaflet-layergroup', CustomElementLayerGroup);
+import { CustomElementTileLayer } from './customElements/tilelayer';
+customElements.get('astro-leaflet-tilelayer') || customElements.define('astro-leaflet-tilelayer', CustomElementTileLayer);
+import { CustomElementControl, CustomElementControlLayer, CustomElementBaseLayer, CustomElementOverlay } from './customElements/control';
+customElements.get('astro-leaflet-control') || customElements.define('astro-leaflet-control', CustomElementControl);
+customElements.get('astro-leaflet-controllayer') || customElements.define('astro-leaflet-controllayer', CustomElementControlLayer);
+customElements.get('astro-leaflet-baselayer') || customElements.define('astro-leaflet-baselayer', CustomElementBaseLayer);
+customElements.get('astro-leaflet-overlay') || customElements.define('astro-leaflet-overlay', CustomElementOverlay);
+import { CustomElementCircle } from './customElements/circle';
+customElements.get('astro-leaflet-circle') || customElements.define('astro-leaflet-circle', CustomElementCircle);
+import { CustomElementGeoJson } from './customElements/geojson';
+customElements.get('astro-leaflet-geojson') || customElements.define('astro-leaflet-geojson', CustomElementGeoJson);
+import { CustomElementPolygon } from './customElements/polygon';
+customElements.get('astro-leaflet-polygon') || customElements.define('astro-leaflet-polygon', CustomElementPolygon);
+import { CustomElementPolyline } from './customElements/polyline';
+customElements.get('astro-leaflet-polyline') || customElements.define('astro-leaflet-polyline', CustomElementPolyline);
+import { CustomElementCreateLeafletIcon, CustomElementMarker } from './customElements/marker';
+customElements.get('create-leaflet-divicon') || customElements.define('create-leaflet-divicon', CustomElementCreateLeafletIcon);
+customElements.get('astro-leaflet-marker') || customElements.define('astro-leaflet-marker', CustomElementMarker);
+import { CustomElementImageOverlay } from './customElements/imageoverlay';
+customElements.get('astro-leaflet-imageoverlay') || customElements.define('astro-leaflet-imageoverlay', CustomElementImageOverlay);
+// Bounds controls must register after the layers they inspect.
+import { CustomElementFitBounds } from './customElements/fitbounds';
+customElements.get('astro-leaflet-fitbounds') || customElements.define('astro-leaflet-fitbounds', CustomElementFitBounds);
+import { CustomElementFitWorld } from './customElements/fitworld';
+customElements.get('astro-leaflet-fitworld') || customElements.define('astro-leaflet-fitworld', CustomElementFitWorld);
+import { CustomElementLocate } from './customElements/locate';
+customElements.get('astro-leaflet-locate') || customElements.define('astro-leaflet-locate', CustomElementLocate);
+import { CustomElementPopup } from './customElements/popup';
+customElements.get('astro-leaflet-popup') || customElements.define('astro-leaflet-popup', CustomElementPopup);
+import { CustomElementTooltip } from './customElements/tooltip';
+customElements.get('astro-leaflet-tooltip') || customElements.define('astro-leaflet-tooltip', CustomElementTooltip);
+import { CustomElementOpenPopup } from './customElements/openpopup';
+customElements.get('astro-leaflet-openpopup') || customElements.define('astro-leaflet-openpopup', CustomElementOpenPopup);
